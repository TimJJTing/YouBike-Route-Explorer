{
	"name": "youbike-routes",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "npm run test:integration && npm run test:unit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.20.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@deck.gl/core": "^9.4.0",
		"@deck.gl/geo-layers": "^9.4.0",
		"@deck.gl/layers": "^9.4.0",
		"@deck.gl/mapbox": "^9.4.0",
		"@duckdb/duckdb-wasm": "^1.32.0",
		"@turf/bezier-spline": "^7.4.0",
		"@turf/distance": "^7.4.0",
		"@turf/helpers": "^7.4.0",
		"@turf/length": "^7.4.0",
		"clsx": "^2.1.1",
		"h3-js": "^4.5.0",
		"mapbox-gl": "^3.33.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	},
	"overrides": {
		"fflate": "^0.8.2",
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		},
		"@luma.gl/gltf": {
			"@loaders.gl/core": "~4.5.4",
			"@loaders.gl/gltf": "~4.5.4",
			"@loaders.gl/textures": "~4.5.4"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
